<section class="card">
  <h2>Solicitar serviço</h2>
  <form {{on "submit" this.enviar}}>
    <label>Seu nome
      <input value={{this.nome}} {{on "input" (fn this.atualizar "nome")}} />
    </label>
    <label>Título do serviço
      <input value={{this.titulo}} {{on "input" (fn this.atualizar "titulo")}} />
    </label>
    <label>Descrição
      <textarea {{on "input" (fn this.atualizar "descricao")}}>{{this.descricao}}</textarea>
    </label>
    <label>Orçamento (R$)
      <input type="number" value={{this.preco}} {{on "input" (fn this.atualizar "preco")}} />
    </label>
    <button type="submit" class="btn">Publicar pedido</button>
  </form>
</section>

<section class="card">
  <h2>Meus pedidos</h2>
  {{#each this.servicos.pedidos as |pedido|}}
    <article class="item">
      <strong>{{pedido.titulo}}</strong> — R$ {{pedido.preco}}
      <span class="status {{pedido.status}}">{{pedido.status}}</span>
      {{#if pedido.prestador}}<small>Prestador: {{pedido.prestador}}</small>{{/if}}
    </article>
  {{else}}
    <p>Nenhum pedido ainda.</p>
  {{/each}}
</section>
